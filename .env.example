# Copy this file to .env.local and fill in your own values. Never commit a real
# secret: .env.example is tracked, .env.local is not.
#
# A real GITHUB_CLIENT_SECRET was committed here in commit 33ff716. It has since
# been removed from this file and scrubbed from git history, and the app no
# longer reads it: admin sign-in is Firebase email and password, and there is no
# GitHub OAuth flow in the source. So the variables are gone rather than rotated,
# and the GitHub OAuth app itself should be deleted. The Firebase values below are
# public by design, since they ship to the browser.

# Portfolio, Firebase. Safe to expose: these are client configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

SITE_URL=http://localhost:5173

# Academy, Supabase. The publishable and anon keys are safe to expose; they are
# protected by row level security. Never put the service role key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Edge function secrets, set with `npx supabase secrets set`, never here:
#   AI_PROVIDER_API_KEY
#   AI_FEEDBACK_MODEL
#   GRADING_EXECUTOR_URL
#   GRADING_EXECUTOR_KEY
