# Copy this file to .env.local and fill in your own values. Never commit a real
# secret: .env.example is tracked, .env.local is not.
#
# A real GITHUB_CLIENT_SECRET was committed here in commit 33ff716. It has been
# removed from this file, but removing it does not unpublish it from git
# history, so the value must be rotated in the GitHub developer settings. The
# Firebase values below are public by design, since they ship to the browser.

# Portfolio, Firebase. Safe to expose: these are client configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GitHub OAuth. Server side only, never prefixed with VITE_.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SITE_URL=http://localhost:5173

# Academy, Supabase. The publishable and anon keys are safe to expose; they are
# protected by row level security. Never put the service role key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Edge function secrets, set with `npx supabase secrets set`, never here:
#   AI_PROVIDER_API_KEY
#   AI_FEEDBACK_MODEL
#   GRADING_EXECUTOR_URL
#   GRADING_EXECUTOR_KEY
