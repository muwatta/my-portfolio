# deploy.sh generates this for you on the host, and writes it here with mode 600.
# Set it only if you are deploying by hand.
#
# This is the shared secret the edge function presents as a bearer token:
#   openssl rand -hex 32
#
# deploy.sh then sets the matching Supabase secrets and refuses to do so until
# the executor answers, rejects a bad token, and grades a real program:
#   PUBLIC_HOST=executor.example.com ./deploy.sh
EXECUTOR_TOKEN=
