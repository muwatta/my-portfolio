# The shared secret the edge function presents as a bearer token. Generate with:
#   openssl rand -hex 32
# The same value goes in the executor's environment and in Supabase:
#   npx supabase secrets set GRADING_EXECUTOR_URL=https://executor.internal \
#     GRADING_EXECUTOR_KEY=<the same token> \
#     GRADING_EXECUTOR_NAME=docker-gpp
EXECUTOR_TOKEN=
